{
  "name": "luft",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "LUFT — observed flights over Europe, a Motion Studies research edition",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:airlines": "node scripts/build-airline-data.mjs && node scripts/build-geography.mjs && node scripts/build-holding-data.mjs",
    "predev": "npm run data:airlines && npm run data:enrichment",
    "prebuild": "npm run data:airlines && npm run data:enrichment",
    "data:land": "node scripts/build-land.mjs",
    "data:holding": "node scripts/build-holding-data.mjs --report",
    "data:enrichment": "node scripts/verify-enrichment.mjs",
    "check:stack": "node scripts/check-stack.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "1.0.0",
    "@motionstudies/data": "1.0.0",
    "@motionstudies/three": "1.0.0",
    "@motionstudies/web": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "spectorjs": "0.9.33",
    "@motionstudies/tooling": "1.0.0"
  }
}
