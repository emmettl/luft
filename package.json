{
  "name": "luft",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "LUFT \u2014 observed flights over Europe, a Motion Studies research edition",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:airlines": "node scripts/build-airline-data.mjs && node scripts/build-geography.mjs && node scripts/build-holding-data.mjs",
    "predev": "npm run data:airlines && npm run data:enrichment",
    "prebuild": "npm run data:airlines && npm run data:enrichment",
    "data:land": "node scripts/build-land.mjs",
    "data:holding": "node scripts/build-holding-data.mjs --report",
    "data:enrichment": "node scripts/verify-enrichment.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.31",
    "@motionstudies/data": "0.1.0-alpha.31",
    "@motionstudies/three": "0.1.0-alpha.31",
    "@motionstudies/web": "0.1.0-alpha.31",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
