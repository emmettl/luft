{
  "name": "luft",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "LUFT — observed flights over Europe, a Motion Studies research edition",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:airlines": "node scripts/build-airline-data.mjs && node scripts/build-geography.mjs",
    "predev": "npm run data:airlines && npm run data:enrichment",
    "prebuild": "npm run data:airlines && npm run data:enrichment",
    "data:land": "node scripts/build-land.mjs",
    "data:enrichment": "node scripts/verify-enrichment.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.26",
    "@motionstudies/three": "0.1.0-alpha.26",
    "@motionstudies/web": "0.1.0-alpha.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
